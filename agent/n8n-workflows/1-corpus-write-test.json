      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "Postgres PGVector Store",
      "type": "@n8n/n8n-nodes-langchain.vectorStorePGVector",
      "typeVersion": 1.3,
      "position": [200, 0],
      "credentials": {
        "postgres": { "id": "REPLACE_WITH_YOUR_POSTGRES_CREDENTIAL_ID", "name": "pgvector (rag)" }
      },
      "notes": "Table name is the ONLY field changed. Column Names is left at its defaults (id / embedding / text / metadata) because store.py deliberately created the table to match them."
