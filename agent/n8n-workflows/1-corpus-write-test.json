              { "name": "title",         "value": "n8n interop probe" },
              { "name": "chunk_id",      "value": "={{ 'n8n-' + $now.toMillis() }}" },
              { "name": "chunk_index",   "value": "0" }
            ]
          }
        }
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Default Data Loader",
      "type": "@n8n/n8n-nodes-langchain.documentDefaultDataLoader",
      "typeVersion": 1.1,
      "position": [140, 200],
      "notes": "Metadata keys mirror what ingest.py writes, so a row written here is shaped like a row written by Python. chunk_id matters most — citations are validated against it."
