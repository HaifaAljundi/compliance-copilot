# Copy to agent/.env and fill in. The real .env is gitignored and chmod 600.
#
# DELIBERATELY SEPARATE from ~/Sites/n8n/.env. That file holds N8N_ENCRYPTION_KEY —
# the value the RUNBOOK calls the single point of unrecoverability. This app has no
# need for it, so it does not read a file that contains it.

# --- Groq (chat models: supervisor, analyst, verifier) ---
# Currently reuses a key from another internal project, so a rotation or revoke there affects this app too.
# Mint a separate key if you later want per-project spend attribution for the
# cost-per-query metric.
GROQ_API_KEY=CHANGE_ME_gsk_...

# --- Vector store ---
# Must match PGVECTOR_PASSWORD in ~/Sites/n8n/.env — same database, two readers.
PGVECTOR_PASSWORD=CHANGE_ME_same_as_n8n_env

# --- n8n integration ---
# Shared secret. Used twice: as the Header Auth value on the n8n Webhook node, and as
# the HMAC-SHA256 key over the raw request body. The header alone proves the caller
# knows a secret; the HMAC proves the body wasn't altered in transit.
#   openssl rand -hex 32
N8N_WEBHOOK_SECRET=CHANGE_ME_openssl_rand_hex_32

# --- This service's own API ---
# Bearer token n8n presents when calling INTO the agent (/ask, /ingest, /resume).
#   openssl rand -hex 32
AGENT_API_KEY=CHANGE_ME_openssl_rand_hex_32

# --- Optional overrides (defaults in app/config.py suit the compose network) ---
# Running ingestion from the HOST rather than inside a container? pgvector publishes no
# port, so reach it through the n8n container's network or temporarily publish one.
# PGVECTOR_HOST=127.0.0.1
# OLLAMA_BASE_URL=http://127.0.0.1:11434     # host default; containers use host.docker.internal
#
# Models must stay DIFFERENT between analyst and verifier — config.py refuses to start
# otherwise, because a self-grading verifier makes the whole eval meaningless.
# ANALYST_MODEL=openai/gpt-oss-120b
# VERIFIER_MODEL=qwen/qwen3.6-27b
