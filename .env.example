# Copy to .env and fill in. The real .env is gitignored and chmod 600.
# Generate strong values:
#   N8N_ENCRYPTION_KEY : openssl rand -hex 32
#   POSTGRES_PASSWORD  : openssl rand -hex 24
#
# WARNING: if N8N_ENCRYPTION_KEY ever changes, every saved credential becomes
# unrecoverable. It is backed up inside every archive by backup.sh. Never log or commit it.

N8N_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
POSTGRES_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# Vector store (pgvector service). Separate DB, separate password from the n8n
# Postgres above — a leak of one must not hand over the other.
#   PGVECTOR_PASSWORD : openssl rand -hex 24
PGVECTOR_PASSWORD=CHANGE_ME_openssl_rand_hex_24
